# EJEMPLO JAV — Variables de Entorno
# Copia este archivo como .env y ajusta los valores.        
# NUNCA subas el .env real al repositorio.                  

# Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=javdb

# Backend
ASPNETCORE_ENVIRONMENT=Development

#    JWT_SECRET — REQUISITO DE SEGURIDAD CRÍTICO
#     La clave DEBE tener mínimo 64 caracteres para cumplir con el estándar HS256. 
#     Claves cortas son rechazadas por el servidor en tiempo de ejecución.

JWT_SECRET=
# Puertos 
BACKEND_PORT=5209
FRONTEND_PORT=3000
DB_PORT=5432